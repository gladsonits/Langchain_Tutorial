   "source": [
    "from detoxify import Detoxify\n",
    "import pandas as pd\n",
    "\n",
    "texts = [\n",
    "    \"Idiot!\",\n",
    "    \"I love you\",\n",
    "    \"You are a terrible person\",\n",
    "    \"You are a wonderful person\"]\n",
    "\n",
    "results = Detoxify('original').predict(texts)\n",
    "\n",
    "df = pd.DataFrame(results, index=texts).round(3)\n",
    "df"
   ]
  }
 ],
